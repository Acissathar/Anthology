#version 460
#extension GL_NV_mesh_shader : require
layout(local_size_x=1) in;
layout(points, max_vertices=1, max_primitives=1) out;
out gl_MeshPerVertexNV { vec4 gl_Position; float gl_PointSize; } gl_MeshVerticesNV[];
perprimitiveNV out gl_MeshPerPrimitiveNV { int gl_PrimitiveID; int gl_ViewportMask[2]; perviewNV int gl_LayerPerViewNV[]; } gl_MeshPrimitivesNV[];
void main(){
    gl_MeshVerticesNV[0].gl_Position = vec4(0); gl_MeshVerticesNV[0].gl_PointSize = 1.0;
    gl_MeshPrimitivesNV[0].gl_PrimitiveID = 7; gl_MeshPrimitivesNV[0].gl_ViewportMask[1] = 2; gl_MeshPrimitivesNV[0].gl_LayerPerViewNV[3] = 1;
    gl_PrimitiveIndicesNV[0] = 0u; gl_PrimitiveCountNV = 1u;
}
