#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { int values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    int16_t a = int16_t(values[i]);
    int16_t r = min(a, int16_t(7)) + max(a, int16_t(-3)) + clamp(a, int16_t(0), int16_t(5));
    values[i] = int(r);
}
