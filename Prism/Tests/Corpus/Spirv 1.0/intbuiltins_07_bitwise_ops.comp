#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    int ia;
    int ib;
    uint ua;
    uint ub;
    int rIAnd;
    int rIOr;
    int rIXor;
    int rINot;
    uint rUAnd;
    uint rUOr;
    uint rUXor;
    uint rUNot;
    uint rMixed;
};

void main() {
    rIAnd = ia & ib;
    rIOr = ia | ib;
    rIXor = ia ^ ib;
    rINot = ~ia;
    rUAnd = ua & ub;
    rUOr = ua | ub;
    rUXor = ua ^ ub;
    rUNot = ~ua;
    rMixed = ua & uint(ia);
}
