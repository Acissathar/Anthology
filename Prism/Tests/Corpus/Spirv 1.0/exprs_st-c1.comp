#version 450
#extension GL_NV_compute_shader_derivatives : require
layout(local_size_x=4, local_size_y=4) in;
layout(derivative_group_quadsNV) in;
layout(binding=0) uniform sampler2D s; layout(binding=1) buffer B { vec4 r; } b;
void main(){ vec2 uv = vec2(gl_GlobalInvocationID.xy) / 16.0; b.r = texture(s, uv) + vec4(dFdx(uv), fwidth(uv)) + textureOffset(s, uv, ivec2(1)); }
