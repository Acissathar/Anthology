#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { int values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    int8_t a = int8_t(values[i]);
    int8_t r = min(a, int8_t(7)) + max(a, int8_t(-3)) + clamp(a, int8_t(0), int8_t(5));
    values[i] = int(r);
}
