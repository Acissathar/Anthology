#version 460
#extension GL_KHR_compute_shader_derivatives : require
layout(local_size_x=4, local_size_y=4) in;
layout(derivative_group_quadsKHR) in;
layout(std430,set=0,binding=0) buffer B { float v[]; };
void main() { float x = v[gl_LocalInvocationIndex]; v[gl_LocalInvocationIndex] = dFdx(x) + dFdy(x); }
