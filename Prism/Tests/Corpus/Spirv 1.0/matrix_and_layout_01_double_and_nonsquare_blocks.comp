#version 460 core

// A matrix lays out like an array of its column vectors, so a dmat's stride follows the DOUBLE column,
// not the 16 a float matrix happens to land on. Non-square shapes pin the column-vs-row convention.

layout(local_size_x = 4) in;

layout(std140, set = 0, binding = 0) uniform Wide
{
    dmat2 d2;
    dmat3 d3;
    dmat2x3 d23;
    mat2x3 m23;
    mat3x2 m32;
    mat2 m2;
    double scalar;
    dvec3 dv3;
} wide;

layout(std430, set = 0, binding = 1) buffer Tight
{
    dmat2 td2;
    mat2 tm2;
    mat2x3 tm23;
    double tScalar;
    double results[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;

    dvec2 a = wide.d2 * dvec2(1.0LF, 2.0LF);
    dvec3 b = wide.d3 * dvec3(1.0LF);
    dvec3 c = wide.d23 * dvec2(0.5LF, 0.25LF);
    vec3 d = wide.m23 * vec2(1.0, 2.0);
    vec2 e = wide.m32 * vec3(1.0);
    vec2 f = wide.m2 * vec2(0.5);

    double sum = a.x + b.y + c.z + wide.scalar + wide.dv3.z + tScalar;
    sum += double(d.x + e.y + f.x);
    sum += (td2 * dvec2(1.0LF)).x;
    sum += double((tm2 * vec2(1.0)).y + (tm23 * vec2(1.0)).z);

    results[i] = sum;
}
