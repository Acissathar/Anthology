#version 460

layout(local_size_x=8, local_size_y=8) in;

layout(rgba32f, set=0, binding=0) uniform image2DMS imgMS;
layout(rgba32f, set=0, binding=1) uniform writeonly image2D imgDst;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 s0 = imageLoad(imgMS, p, 0);
    vec4 s1 = imageLoad(imgMS, p, 1);
    imageStore(imgDst, p, s0 + s1);
}
