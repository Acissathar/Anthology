#version 460 core

// Clears the depth SSBO to "far" and the packed color SSBO to a background color.
// Dispatched 1D over the flattened pixel count.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer DepthBufferSSBO {
    uint depth[];
} depthBuffer;

layout(set = 0, binding = 1, std430) buffer ColorBufferSSBO {
    uint colorPacked[];
} colorBuffer;

layout(push_constant) uniform ClearPushConstants {
    uint screenWidth;
    uint screenHeight;
    uint clearColorPacked;
    uint depthClearValue;
} pc;

void main() {
    uint pixelIndex = gl_GlobalInvocationID.x;
    uint pixelCount = pc.screenWidth * pc.screenHeight;
    if (pixelIndex >= pixelCount) {
        return;
    }

    depthBuffer.depth[pixelIndex] = pc.depthClearValue;
    colorBuffer.colorPacked[pixelIndex] = pc.clearColorPacked;
}
