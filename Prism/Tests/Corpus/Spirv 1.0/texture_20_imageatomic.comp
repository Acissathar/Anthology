#version 460

layout(local_size_x=8, local_size_y=8) in;

layout(r32ui, set=0, binding=0) uniform uimage2D imgCount;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    uint prev = imageAtomicAdd(imgCount, p, 1u);
    uint old = imageAtomicExchange(imgCount, p, prev);
    imageStore(imgCount, p, uvec4(old, 0u, 0u, 0u));
}
