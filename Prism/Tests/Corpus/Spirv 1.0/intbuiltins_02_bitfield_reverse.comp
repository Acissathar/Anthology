#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    int si;
    uint ui;
    ivec2 sv;
    uvec2 uv;
    int rS;
    uint rU;
    ivec2 rSV;
    uvec2 rUV;
};

void main() {
    rS = bitfieldReverse(si);
    rU = bitfieldReverse(ui);
    rSV = bitfieldReverse(sv);
    rUV = bitfieldReverse(uv);
}
