#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    uint result;
};

shared uint total;

void main() {
    if (gl_LocalInvocationID.x == 0u) {
        total = 0u;
    }
    barrier();

    atomicAdd(total, 1u);
    barrier();

    if (gl_LocalInvocationID.x == 0u) {
        result = total;
    }
}
