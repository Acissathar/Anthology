#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    float inVal;
    uint outData[];
} b;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    int i = floatBitsToInt(b.inVal);
    float f = intBitsToFloat(i);
    uint u = floatBitsToUint(f);
    b.outData[idx] = u + uint(i);
}
