#version 460 core

// imageLoad/imageStore on an r32i iimage2D: the integer format signedness drives the SignExtend operand.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32i) uniform iimage2D img;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec4 texel = imageLoad(img, coord);
    imageStore(img, coord, texel + ivec4(1));
}
