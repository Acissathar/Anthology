#version 460 core

// image2DMS: per-sample imageLoad/imageStore.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform image2DMS img;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec4 texel = imageLoad(img, coord, 1);
    imageStore(img, coord, 1, texel * 0.5);
}
