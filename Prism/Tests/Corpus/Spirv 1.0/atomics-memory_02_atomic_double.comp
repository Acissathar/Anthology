#version 460
#extension GL_EXT_shader_atomic_float : require
#extension GL_EXT_shader_atomic_float2 : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data {
    double sum;
    double lo;
    double hi;
    double xchg;
    double results[];
};
void main()
{
    uint i = gl_GlobalInvocationID.x;
    double v = double(i);
    double a = atomicAdd(sum, v);
    double b = atomicMin(lo, v);
    double c = atomicMax(hi, v);
    double d = atomicExchange(xchg, v);
    results[i] = a + b + c + d;
}
