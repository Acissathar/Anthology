#version 460 core
#extension GL_ARB_gpu_shader_int64 : require

// ++/-- adds a SIGNED one of the operand's width whatever its signedness, and smears it to match a
// vector rather than promoting. Each width picks a different constant.

layout(local_size_x = 4) in;

layout(std430, set = 0, binding = 0) buffer Out
{
    float results[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;

    int si = 1;
    uint ui = 1u;
    float f = 1.0;
    double d = 1.0LF;
    int64_t i64 = 1L;
    uint64_t u64 = 1UL;

    ivec2 iv = ivec2(1, 2);
    uvec3 uv = uvec3(1u, 2u, 3u);
    vec4 fv = vec4(1.0, 2.0, 3.0, 4.0);
    dvec2 dv = dvec2(1.0LF, 2.0LF);

    si++; ++si; si--; --si;
    ui++; ++ui; ui--;
    f++; ++f; f--;
    d++; --d;
    i64++; --i64;
    u64++; --u64;

    iv++; ++iv; iv--;
    uv++; --uv;
    fv++; ++fv;
    dv--;

    int post = si++;
    int pre = ++si;
    ivec2 vpost = iv++;
    ivec2 vpre = --iv;

    float acc = float(si + post + pre) + float(ui) + f + float(d)
              + float(i64) + float(u64)
              + float(iv.x + vpost.y + vpre.x) + float(uv.z) + fv.w + float(dv.y);
    results[i] = acc;
}
