#version 460
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { vec4 values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    vec4 x = values[i];
    vec4 lo = vec4(0.0);
    vec4 hi = vec4(1.0);
    values[i] = min(x, hi) + max(x, lo) + clamp(x, lo, hi);
}
