#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    vec2 inHalf;
    vec4 inUnorm;
    uint outData[];
} b;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint h = packHalf2x16(b.inHalf);
    vec2 hu = unpackHalf2x16(h);
    uint p = packUnorm4x8(b.inUnorm);
    vec4 pu = unpackUnorm4x8(p);
    b.outData[idx] = h ^ p ^ floatBitsToUint(hu.x + pu.y);
}
