#version 460
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    ivec2 iv;
    uvec2 uv;
    ivec2 rIUnpacked;
    uvec2 rUUnpacked;
};

void main() {
    int64_t packedI = packInt2x32(iv);
    rIUnpacked = unpackInt2x32(packedI);
    uint64_t packedU = packUint2x32(uv);
    rUUnpacked = unpackUint2x32(packedU);
}
