#version 460 core

// imageCubeArray: imageLoad/imageStore with an ivec3 coordinate (needs the ImageCubeArray capability).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform imageCubeArray img;

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    vec4 texel = imageLoad(img, coord);
    imageStore(img, coord, texel + vec4(0.25));
}
