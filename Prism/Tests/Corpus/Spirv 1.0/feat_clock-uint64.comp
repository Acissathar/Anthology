#version 450
#extension GL_ARB_shader_clock : require
#extension GL_EXT_shader_realtime_clock : require
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x=1) in;
layout(std430, binding=0) buffer B { uint64_t a; uint64_t b; uvec2 c; } buf;
void main(){ buf.a = clockARB(); buf.b = clockRealtimeEXT() - buf.a; buf.c = clockRealtime2x32EXT() + clock2x32ARB(); }
