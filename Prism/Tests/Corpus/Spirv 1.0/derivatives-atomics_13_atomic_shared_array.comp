#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    uint histogram[64];
};

shared uint bins[64];

void main() {
    uint lid = gl_LocalInvocationID.x;
    bins[lid] = 0u;
    barrier();

    atomicAdd(bins[lid & 15u], 1u);
    barrier();

    histogram[lid] = bins[lid];
}
