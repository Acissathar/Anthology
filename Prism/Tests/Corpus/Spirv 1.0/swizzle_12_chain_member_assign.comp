#version 460
layout(local_size_x=64) in;

struct Inner { vec4 vecField; };
struct Outer { Inner member; };
layout(std430, binding=0) buffer B { Outer items[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    float f = items[i].member.vecField.x;
    items[i].member.vecField.z = f + 1.0;
}
