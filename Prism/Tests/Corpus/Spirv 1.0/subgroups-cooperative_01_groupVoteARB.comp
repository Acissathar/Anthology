#version 460
#extension GL_ARB_shader_group_vote : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    bool cond = values[i] > 10u;
    uint r = 0u;
    if (anyInvocationARB(cond)) r += 1u;
    if (allInvocationsARB(cond)) r += 2u;
    if (allInvocationsEqualARB(cond)) r += 4u;
    values[i] = r;
}
