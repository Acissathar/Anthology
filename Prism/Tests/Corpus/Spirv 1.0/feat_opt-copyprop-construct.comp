#version 450
layout(local_size_x=1) in;
struct P { vec2 a; float b[2]; };
layout(std430, binding=0) readonly buffer In { P p[4]; } src;
layout(std430, binding=1) buffer Out { vec2 r; } dst;
void main(){ float arr[2] = float[2](src.p[1].b[0], src.p[1].b[1]); int i = int(dst.r.x); dst.r = vec2(arr[i], arr[1 - i]); }
