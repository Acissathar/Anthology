#version 460

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer B {
    int si;
    uint ui;
    int sAmount;
    uint uAmount;
    int rSLeft;
    int rSRight;
    uint rULeft;
    uint rURight;
    int rSByU;
    uint rUByU;
};

void main() {
    rSLeft = si << sAmount;
    rSRight = si >> sAmount;
    rULeft = ui << uAmount;
    rURight = ui >> uAmount;
    rSByU = si << uAmount;
    rUByU = ui >> sAmount;
}
