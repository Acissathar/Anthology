#version 460 core

// Specialization survives only through operations OpSpecConstantOp can express: int/bool to int/bool
// conversions stay specializable (a signedness change adds an unsigned zero rather than bitcasting),
// but anything crossing into the floating domain becomes ordinary runtime code.

layout(local_size_x = 8) in;

layout(constant_id = 0) const int COUNT = 8;
layout(constant_id = 1) const uint STRIDE = 4u;
layout(constant_id = 2) const bool ENABLED = true;
layout(constant_id = 3) const float SCALE = 2.0;

layout(std430, set = 0, binding = 0) buffer Out
{
    float results[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;

    // int <-> uint: stays a spec op.
    uint asUint = uint(COUNT);
    int asInt = int(STRIDE);

    // bool <-> int: also integral, so still a spec op.
    int boolAsInt = int(ENABLED);
    bool intAsBool = bool(COUNT);

    // into the floating domain: runtime conversions.
    float asFloat = float(COUNT);
    float uAsFloat = float(STRIDE);

    // integral spec arithmetic stays specializable; float arithmetic does not.
    uint combined = asUint * STRIDE + 1u;
    int shifted = COUNT << 2;
    int masked = COUNT & 7;
    float scaled = SCALE * 2.0;

    float v = float(combined) + float(shifted + masked + boolAsInt + asInt)
            + asFloat + uAsFloat + scaled;
    if (intAsBool) v += 1.0;
    results[i] = v;
}
