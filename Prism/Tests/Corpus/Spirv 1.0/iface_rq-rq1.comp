#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=1) in;
layout(binding=0) uniform accelerationStructureEXT tlas;
layout(std430, binding=1) buffer B { vec3 v; float f; } b;

void main(){ rayQueryEXT q; rayQueryInitializeEXT(q, tlas, 0u, 0xFFu, vec3(0), 0.0, vec3(1), 1.0); rayQueryProceedEXT(q); b.v = rayQueryGetIntersectionObjectToWorldEXT(q,true)[3]; }
