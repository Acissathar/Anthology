#version 460 core

// GPU-resident particle emitter. Pops free slots from a stack-based free
// list and initializes new particles with a PCG hash based PRNG.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle
{
    vec3 position;
    float age;
    vec3 velocity;
    float lifetime;
    float size;
    float rotation;
    uint seed;
    float padding0;
};

layout(std430, set = 0, binding = 0) buffer ParticleBuffer
{
    Particle particles[];
};

layout(std430, set = 0, binding = 1) buffer FreeListBuffer
{
    int freeListTop;
    uint freeList[];
};

layout(push_constant) uniform EmitPushConstants
{
    uint emitCount;
    uint frameSeed;
    vec3 emitPosition;
    vec3 emitDirection;
    float coneAngle;
    float minSpeed;
    float maxSpeed;
    float minLifetime;
    float maxLifetime;
    float minSize;
    float maxSize;
} pc;

uint pcgHash(uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hashToFloat(uint h)
{
    return float(h) * (1.0 / 4294967296.0);
}

void buildBasis(vec3 n, out vec3 t, out vec3 b)
{
    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    t = normalize(cross(up, n));
    b = cross(n, t);
}

vec3 sampleCone(vec3 dir, float halfAngle, float u1, float u2)
{
    vec3 t, b;
    buildBasis(dir, t, b);
    float cosAngle = mix(cos(halfAngle), 1.0, u1);
    float sinAngle = sqrt(max(0.0, 1.0 - cosAngle * cosAngle));
    float phi = u2 * 6.28318530718;
    vec3 localDir = vec3(sinAngle * cos(phi), sinAngle * sin(phi), cosAngle);
    return normalize(localDir.x * t + localDir.y * b + localDir.z * dir);
}

void main()
{
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.emitCount)
    {
        return;
    }

    int oldTop = atomicAdd(freeListTop, -1);
    if (oldTop <= 0)
    {
        // free list exhausted, undo the decrement and bail
        atomicAdd(freeListTop, 1);
        return;
    }

    uint slotIndex = freeList[uint(oldTop - 1)];

    uint baseSeed = pcgHash(slotIndex ^ pc.frameSeed);
    uint seedSpeed = pcgHash(baseSeed);
    uint seedU1 = pcgHash(seedSpeed);
    uint seedU2 = pcgHash(seedU1);
    uint seedLife = pcgHash(seedU2);
    uint seedSize = pcgHash(seedLife);
    uint seedRot = pcgHash(seedSize);

    float speedT = hashToFloat(seedSpeed);
    float u1 = hashToFloat(seedU1);
    float u2 = hashToFloat(seedU2);
    float lifeT = hashToFloat(seedLife);
    float sizeT = hashToFloat(seedSize);
    float rotT = hashToFloat(seedRot);

    vec3 dir = sampleCone(normalize(pc.emitDirection), pc.coneAngle, u1, u2);
    float speed = mix(pc.minSpeed, pc.maxSpeed, speedT);

    Particle p;
    p.position = pc.emitPosition;
    p.velocity = dir * speed;
    p.age = 0.0;
    p.lifetime = mix(pc.minLifetime, pc.maxLifetime, lifeT);
    p.size = mix(pc.minSize, pc.maxSize, sizeT);
    p.rotation = rotT * 6.28318530718;
    p.seed = baseSeed;
    p.padding0 = 0.0;

    particles[slotIndex] = p;
}
