#version 460
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Blocks { float data[]; } blocks[];
layout(std430, set = 0, binding = 1) buffer Out { float result[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint idx = uint(result[i]);
    result[i] = blocks[nonuniformEXT(idx)].data[i];
}
