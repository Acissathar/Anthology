#version 450
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x=8) in;
layout(std430, binding=0) buffer B { float r[4]; } b;
void main(){
    mediump float m = b.r[0];
    b.r[1] = m * float(gl_LocalInvocationIndex);
    b.r[2] = m * float(gl_SubgroupInvocationID);
    b.r[3] = m + float(gl_NumWorkGroups.x);
}
