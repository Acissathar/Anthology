#version 460
#extension GL_NV_shader_subgroup_partitioned : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uvec4 ballot = subgroupPartitionNV(values[i]);
    values[i] = ballot.x + ballot.y + ballot.z + ballot.w;
}
