#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    bool b = values[i] > 10u;
    values[i] = subgroupExclusiveOr(b) ? 1u : 0u;
}
