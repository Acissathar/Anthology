#version 460
#extension GL_NV_shader_subgroup_partitioned : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint v = values[i];
    uvec4 part = subgroupPartitionNV(v);
    values[i] = subgroupPartitionedExclusiveAddNV(v, part);
}
