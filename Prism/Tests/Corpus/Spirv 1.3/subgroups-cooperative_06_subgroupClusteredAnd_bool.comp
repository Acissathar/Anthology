#version 460
#extension GL_KHR_shader_subgroup_clustered : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    bool b = values[i] > 10u;
    values[i] = subgroupClusteredAnd(b, 4u) ? 1u : 0u;
}
