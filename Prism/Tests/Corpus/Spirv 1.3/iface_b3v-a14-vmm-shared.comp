#version 450
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model
layout(local_size_x=1) in;
layout(std430, binding=0) buffer B { uint d; float f[4]; } b;
shared uint sh; shared float sa[4];
void main(){ sh = 1u; sa[1] = 2.0; barrier(); b.d = sh; b.f[2] = sa[1]; uint t = sh + 1u; b.d += t; }
