#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 1) in;
layout(buffer_reference, std430) buffer Bytes { uint8_t b[]; };
layout(push_constant) uniform P { Bytes p; } pc;
layout(std430, set = 0, binding = 0) buffer O { uint o; };
void main() { o = uint(pc.p.b[3]); }
