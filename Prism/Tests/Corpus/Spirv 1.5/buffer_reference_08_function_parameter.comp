#version 450
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 1) in;
layout(buffer_reference) buffer Node;
layout(buffer_reference, std430) buffer Node { Node next; float v; };
layout(push_constant) uniform P { Node head; } pc;
float sum2(Node n) { return n.v + n.next.v; }
void main() { pc.head.v = sum2(pc.head); }
