#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 1) in;
layout(buffer_reference, std430) buffer Data { float v; };
layout(push_constant) uniform P { uint64_t addr; Data d; } pc;
layout(std430, set = 0, binding = 0) buffer O { uint64_t o; };
void main() { Data d = Data(pc.addr + 16ul); d.v = 1.0; o = uint64_t(pc.d); }
