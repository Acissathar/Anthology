#version 460
#extension GL_NV_ray_tracing : require

layout(binding = 0) uniform accelerationStructureNV tlas;
layout(binding = 1, rgba32f) uniform image2D img;
layout(location = 0) rayPayloadNV vec4 payload;

void main()
{
    vec3 origin = vec3(0.0);
    vec3 dir = vec3(0.0, 0.0, 1.0);
    traceNV(tlas, gl_RayFlagsOpaqueNV, 0xFF, 0, 0, 0, origin, 0.001, dir, 1000.0, 0);
    imageStore(img, ivec2(gl_LaunchIDNV.xy), payload);
}
