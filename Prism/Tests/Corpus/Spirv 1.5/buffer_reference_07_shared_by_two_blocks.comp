#version 450
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 1) in;
layout(buffer_reference, std430) buffer Data { vec4 v; };
layout(push_constant) uniform P { Data a; } pc;
layout(std430, set = 0, binding = 0) buffer S { Data b; uint n; } s;
void main() { pc.a.v = s.b.v * float(s.n); }
