#version 460
#pragma use_vulkan_memory_model
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
layout(r32ui, set = 0, binding = 1) uniform uimage2D img;
shared uint scratch[64];
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint l = gl_LocalInvocationID.x;
    scratch[l] = i;
    imageStore(img, ivec2(l, 0), uvec4(i));
    memoryBarrier();
    memoryBarrierBuffer();
    memoryBarrierShared();
    memoryBarrierImage();
    groupMemoryBarrier();
    values[i] = scratch[l] + imageLoad(img, ivec2(l, 0)).x;
}
