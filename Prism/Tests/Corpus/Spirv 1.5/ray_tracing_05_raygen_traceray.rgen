#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(location = 0) rayPayloadEXT vec4 payload;

void main()
{
    vec3 origin = vec3(vec2(gl_LaunchIDEXT.xy) / vec2(gl_LaunchSizeEXT.xy), 0.0);
    vec3 dir = vec3(0.0, 0.0, 1.0);
    payload = vec4(0.0);
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, origin, 0.001, dir, 10000.0, 0);
}
