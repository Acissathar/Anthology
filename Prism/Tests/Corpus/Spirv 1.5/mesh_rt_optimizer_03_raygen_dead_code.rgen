//spv 1.4
#version 460
#extension GL_EXT_ray_tracing : require
layout(set=0,binding=0) uniform accelerationStructureEXT tlas;
layout(set=0,binding=1, rgba32f) uniform image2D img;
layout(location=0) rayPayloadEXT vec4 payload;
vec3 dir(vec2 uv) { for (int i = 0; i < 0; ++i) uv += vec2(1.0); return vec3(uv, 1.0); }
void main() {
  vec2 uv = vec2(gl_LaunchIDEXT.xy) / vec2(gl_LaunchSizeEXT.xy);
  payload = vec4(0.0);
  if (uv.x > 2.0) { return; }
  traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, vec3(0.0), 0.001, dir(uv), 1000.0, 0);
  imageStore(img, ivec2(gl_LaunchIDEXT.xy), payload);
}
