#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;

layout(set = 0, binding = 0) uniform Camera
{
    mat4 viewProj;
    vec4 baseColor;
} camera;

layout(location = 0) out vec3 vWorldPos[];
layout(location = 1) perprimitiveEXT out vec4 primColor[];

void main()
{
    SetMeshOutputsEXT(4u, 2u);

    const vec2 corners[4] = vec2[4](
        vec2(-1.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 1.0), vec2(1.0, 1.0)
    );

    for (uint i = 0u; i < 4u; i++)
    {
        vec4 world = vec4(corners[i], 0.0, 1.0);
        gl_MeshVerticesEXT[i].gl_Position = camera.viewProj * world;
        vWorldPos[i] = world.xyz;
    }

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(1, 3, 2);

    primColor[0] = camera.baseColor;
    primColor[1] = camera.baseColor * 0.5;
}
