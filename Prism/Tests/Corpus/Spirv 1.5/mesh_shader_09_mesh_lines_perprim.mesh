#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(lines, max_vertices = 4, max_primitives = 2) out;

layout(location = 0) perprimitiveEXT out vec4 lineColor[];

void main()
{
    SetMeshOutputsEXT(4u, 2u);

    gl_MeshVerticesEXT[0].gl_Position = vec4(-1.0, 0.0, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4( 0.0, 0.0, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4( 0.0, 0.0, 0.0, 1.0);
    gl_MeshVerticesEXT[3].gl_Position = vec4( 1.0, 0.0, 0.0, 1.0);

    gl_PrimitiveLineIndicesEXT[0] = uvec2(0, 1);
    gl_PrimitiveLineIndicesEXT[1] = uvec2(2, 3);

    lineColor[0] = vec4(1.0, 0.0, 0.0, 1.0);
    lineColor[1] = vec4(0.0, 1.0, 0.0, 1.0);
}
