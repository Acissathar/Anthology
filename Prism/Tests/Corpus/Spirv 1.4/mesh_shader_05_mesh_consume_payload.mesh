#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;

struct Payload
{
    uint baseId;
    vec3 center;
};
taskPayloadSharedEXT Payload payload;

layout(location = 0) out vec3 vColor[];

void main()
{
    SetMeshOutputsEXT(3u, 1u);

    vec3 c = payload.center;
    gl_MeshVerticesEXT[0].gl_Position = vec4(c + vec3(-1.0, -1.0, 0.0), 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(c + vec3( 1.0, -1.0, 0.0), 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(c + vec3( 0.0,  1.0, 0.0), 1.0);

    float id = float(payload.baseId);
    vColor[0] = vec3(id, 0.0, 0.0);
    vColor[1] = vec3(0.0, id, 0.0);
    vColor[2] = vec3(0.0, 0.0, id);

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}
