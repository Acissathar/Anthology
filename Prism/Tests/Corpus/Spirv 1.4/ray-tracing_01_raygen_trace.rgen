#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 0) rayPayloadEXT vec4 payload;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D outImage;

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(gl_LaunchSizeEXT.xy);

    vec3 origin = vec3(uv * 2.0 - 1.0, 0.0);
    vec3 direction = normalize(vec3(0.0, 0.0, 1.0));

    payload = vec4(0.0);
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u,
                origin, 0.001, direction, 10000.0, 0);

    imageStore(outImage, pixel, payload);
}
