#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=1) in;
layout(triangles, max_vertices=3, max_primitives=1) out;
taskPayloadSharedEXT uint ids[8];
out gl_MeshPerVertexEXT { vec4 gl_Position; float gl_PointSize; } gl_MeshVerticesEXT[];
void main(){ SetMeshOutputsEXT(3, 1); gl_MeshVerticesEXT[0].gl_Position = vec4(ids[gl_WorkGroupID.x]); gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0,1,2); }
