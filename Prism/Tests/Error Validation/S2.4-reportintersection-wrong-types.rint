// S2.4 intrinsic argument types not checked: reportIntersectionNV(bool HitT, uint Kind)
// -> spirv-val "Hit must be a 32-bit int scalar"; reportIntersectionEXT(float, float)
// -> "Hit Kind must be a 32-bit unsigned int scalar". glslang type-checks these args.
// Expected today: compiles + INVALID module (BUG). (Fuzz-found shapes.)
#version 460
#extension GL_EXT_ray_tracing : require
hitAttributeEXT vec2 attribs;
void main() {
  attribs = vec2(0.5);
  reportIntersectionEXT(gl_RayTmaxEXT, 0.5);   // float hitKind -> invalid
}
