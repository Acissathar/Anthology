#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_cull_mask : require
layout(location=0) rayPayloadEXT float a;
layout(binding=0) uniform accelerationStructureEXT tlas;
void main(){ traceRayEXT(tlas, gl_RayFlagsCullBackFacingTrianglesEXT|gl_RayFlagsCullOpaqueEXT|gl_RayFlagsNoOpaqueEXT|gl_RayFlagsCullNoOpaqueEXT|gl_RayFlagsSkipAABBEXT, 0xFFu, 0u, 0u, 0u, vec3(0), 0.0, vec3(1), 1.0, 0); }
