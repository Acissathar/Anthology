// atomicExchange uses gl_StorageSemanticsBuffer (non-zero storage-class semantics) with gl_SemanticsRelaxed:
// a storage-class semantic requires an Acquire/Release/AcquireRelease memory order, so glslang rejects it.
#version 460
#extension GL_KHR_memory_scope_semantics : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
shared uint acc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    atomicMax(values[0], values[i], gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease);
    uint old = atomicExchange(values[1], i, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelaxed);
    atomicOr(acc, 1u, gl_ScopeWorkgroup, gl_StorageSemanticsShared, gl_SemanticsRelaxed);
    values[i] = old + acc;
}
